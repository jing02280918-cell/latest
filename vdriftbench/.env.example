# V-DriftBench runtime credentials / endpoints.
#
# Copy to `.env` (gitignored) and fill in the target model's key:
#     cp .env.example .env
# `main.py` auto-loads `./.env` (or the repo-root `.env`) via
# vdriftbench/env_loader.py — no `export` and no python-dotenv needed. Real
# shell exports always take priority over this file.
#
# Only ONE value below actually has to be filled in: DEEPSEEK_API_KEY. The
# local vLLM personas (judge / classifier / draft / plausibility) authenticate
# with the literal "EMPTY" and are already pointed at the loopback ports that
# scripts/deploy/serve_draft.sh and serve_judge.sh listen on.

# --- target model under test (remote, REQUIRED) ---
# The evaluated model. base_url defaults to https://api.deepseek.com for any
# model name starting with "deepseek", so the key alone is enough.
DEEPSEEK_API_KEY=

# --- Qwen / 通义千问 (DashScope, OpenAI-compatible) ---
DASHSCOPE_API_KEY=
# VDB_TARGET_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VDB_TARGET_MODEL=qwen-plus

# --- local vLLM personas (defaults match the serve_*.sh ports) ---
# judge: 5-dim scoring + section 9.2 RWI review. serve_judge.sh, port 8002.
VDB_JUDGE_API_KEY=EMPTY
VDB_JUDGE_BASE_URL=http://127.0.0.1:8002/v1

# classifier: state-cascade Layer 3. Falls back to the judge endpoint when
# unset, but set explicitly so a later judge change can't silently move it.
VDB_CLASSIFIER_API_KEY=EMPTY
VDB_CLASSIFIER_BASE_URL=http://127.0.0.1:8002/v1

# draft: O-T-R free generation. serve_draft.sh, port 8001.
VDB_DRAFT_API_KEY=EMPTY
VDB_DRAFT_BASE_URL=http://127.0.0.1:8001/v1

# plausibility: section 9.2 realism/persuasiveness review, reuses the draft server.
VDB_PLAUSIBILITY_API_KEY=EMPTY
VDB_PLAUSIBILITY_BASE_URL=http://127.0.0.1:8001/v1

# enrich: one-off dataset preprocessing (target_claim / value_axis /
# risk_type / expected_safe_behavior).
#
# Left UNSET on purpose, so it falls back to DEEPSEEK_API_KEY above and runs
# on deepseek-v4-flash — the model v3.10 enriched with (docs/HANDOFF.md:381,
# README.md:102). Enrichment is not incremental: it regenerates all 314 rows
# every time, so pointing it at the local draft model would silently swap the
# provenance of every target_claim to a different model family and confound
# any v3.10-vs-v3.11 comparison with a change unrelated to the prompt
# rewrites. Only uncomment to save target-model quota on a throwaway run whose
# numbers won't be compared against v3.10.
# VDB_ENRICH_API_KEY=EMPTY
# VDB_ENRICH_BASE_URL=http://127.0.0.1:8001/v1

# --- HuggingFace cache (weights are already present; do NOT change) ---
# The three local models are cached under /hy-tmp/hf_cache. Note the two
# different layouts in use, which resolve to different subdirectories:
#   - vLLM gets `--download-dir /hy-tmp/hf_cache`, i.e. HF `cache_dir`
#     semantics, which places repos at /hy-tmp/hf_cache/models--*  <- the
#     complete draft (18GB) and judge (27GB) weights live here.
#   - sentence-transformers resolves via HF_HOME, i.e. /hy-tmp/hf_cache/hub/,
#     where the complete bge-m3 copy lives.
# Both are satisfied by the values below. Setting HF_HUB_CACHE instead of
# HF_HOME would break the embedding lookup, and dropping --download-dir would
# make vLLM re-download ~45GB.
HF_HOME=/hy-tmp/hf_cache
HF_ENDPOINT=https://hf-mirror.com
# Do NOT set HF_HUB_ENABLE_HF_TRANSFER=1 — hf_transfer isn't installed in the
# venv and vLLM's weight loader crashes with ModuleNotFoundError.
